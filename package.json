{
  "name": "spendveto",
  "version": "0.31.0",
  "description": "Spend controls for AI agents: a budget, loop detection and a kill switch in front of every model call (Claude Code, Codex, OpenAI/Anthropic SDKs), x402 payment and card authorization — open source, self-hosted.",
  "license": "Apache-2.0",
  "author": "Revanth Rajeev",
  "homepage": "https://spendveto.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revanthrajeev/spendveto.git"
  },
  "bugs": {
    "url": "https://github.com/revanthrajeev/spendveto/issues"
  },
  "keywords": [
    "ai-agents",
    "llm",
    "budget",
    "spend-control",
    "claude-code",
    "openai",
    "anthropic",
    "llm-gateway",
    "x402",
    "mcp",
    "governance",
    "finops"
  ],
  "type": "module",
  "bin": {
    "spendveto": "bin/spendveto.mjs"
  },
  "files": [
    "bin/",
    "server/",
    "client/",
    "proxy/",
    "rails/",
    "dashboard/",
    "mcp/",
    "integrations/",
    "sdk/index.js",
    "sdk/index.d.ts",
    "spec/",
    "shared-config.js",
    "data/policy-packs/",
    "data/policy.json",
    "server.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.18"
  },
  "mcpName": "io.github.revanthrajeev/spendveto",
  "scripts": {
    "server": "node server/index.js",
    "start": "node bin/spendveto.mjs",
    "call": "node client/pay-and-call.js",
    "mcp": "node mcp/server.js",
    "delegate": "node scripts/delegate.mjs",
    "verify": "node scripts/verify.mjs",
    "check-chains": "node scripts/check-chains.mjs",
    "gen-wallets": "node scripts/gen-wallets.mjs",
    "apikey": "node scripts/apikey.mjs",
    "deploy-safe-allowance": "node scripts/deploy-safe-allowance.mjs",
    "site": "node scripts/site.mjs",
    "demo": "node scripts/demo-record.mjs",
    "proxy": "node proxy/server.js",
    "policy": "node scripts/policy.mjs",
    "quickstart:ai": "node scripts/quickstart-ai.mjs",
    "sanctions:update": "node scripts/fetch-sanctions-list.mjs",
    "govern": "node govern/server.js",
    "govern:admin": "node govern/cli.js",
    "test:govern": "node govern/tests/preflight.mjs && node --test --test-concurrency=1 \"govern/tests/*.test.mjs\""
  },
  "dependencies": {
