# Copy to .env.local and fill in. Nothing here is required to run `npm run verify`
# (simulate mode works with zero setup) — these matter for SPENDVETO_MODE=testnet.

# Real agent output instead of the canned fallback. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Which rail to use. simulate = zero setup, no blockchain calls, real Claude calls
# if ANTHROPIC_API_KEY is set. testnet = real x402 protocol on Base Sepolia.
SPENDVETO_MODE=simulate

# Only needed for SPENDVETO_MODE=testnet — generate both with `npm run gen-wallets`.
CLIENT_PRIVATE_KEY=
SERVER_PAYOUT_ADDRESS=

# Optional — only used when calling the solana-devnet chain in testnet mode.
# Base58-encoded 64-byte Solana secret key (e.g. `solana-keygen new`, then
# `cat ~/.config/solana/id.json | node -e "..."` to base58-encode, or export
# from Phantom). Left unset, a fresh ephemeral keypair is generated per run —
# fine to exercise the rail, but it will never hold funded devnet USDC.
CLIENT_SOLANA_PRIVATE_KEY=

# Same pattern for every other family the public facilitator settles today —
# each optional, each falls back to an ephemeral (unfunded) key when unset.
# Base payout addresses (SERVER_PAYOUT_ADDRESS_*) are separate from client
# keys: without one set, that family's chain never enters liveSettlementChains,
# whatever the facilitator supports — see server/index.js.

# Aptos testnet — AIP-80 or hex private key from `aptos init` / Petra export.
CLIENT_APTOS_PRIVATE_KEY=
SERVER_PAYOUT_ADDRESS_APTOS=

# Stellar testnet — classic (G) account secret key, starts with "S".
CLIENT_STELLAR_PRIVATE_KEY=
SERVER_PAYOUT_ADDRESS_STELLAR=

# Hedera testnet — NO ephemeral fallback exists (an account id is assigned
# on-chain, not derived from a key). Create a free one at
# https://portal.hedera.com, then set both.
CLIENT_HEDERA_ACCOUNT_ID=
CLIENT_HEDERA_PRIVATE_KEY=
SERVER_PAYOUT_ADDRESS_HEDERA=

# XRPL — MAINNET, not testnet: this is the one chain in the registry
# settling real money. Family secret ("s...", from `xrpl-cli wallet create`
# or any XRPL wallet's seed export). Leave unset unless you mean it.
CLIENT_XRPL_SEED=
SERVER_PAYOUT_ADDRESS_XRPL=

# SVM payout address (Base58 Solana address) — required alongside
# CLIENT_SOLANA_PRIVATE_KEY above for solana-devnet to go live.
# A freshly generated address has no USDC token account on-chain yet, and the
# x402 SVM client does not create the destination's account for you (that's
# the seller's job, by protocol design) — a payment to it fails at simulation
# with "transaction_simulation_failed" until it holds at least a nonzero
# balance once, e.g. by requesting devnet USDC to it from faucet.circle.com
# the same way you funded the client. One-time setup per payout address.
SERVER_PAYOUT_ADDRESS_SVM=

# x402 v2 facilitator override (default: https://x402.org/facilitator).
# Point at Coinbase CDP's facilitator + configure your CDP API key to unlock mainnet chains.
# SPENDVETO_FACILITATOR_URL=

# API-spend rail rates, USD per million tokens (set from your provider's price sheet)
# LLM_RATE_IN_PER_M=1.0
# LLM_RATE_OUT_PER_M=1.0
# LLM_MODEL=claude-haiku-4-5-20251001

# --- Console address -----------------------------------------------------------
# The Console's public URL. Invite links (npm run user) point at it, and wallet
# sign-in names its domain in every message — set it on any public deployment,
# or the domain comes from the request's Host header, which the caller picks.
# SPENDVETO_PUBLIC_URL=https://app.spendveto.com

# --- Email (server/mailer.js — the Console's invites, the Governance API's signup and welcome) ---
# Unset: nothing is emailed. The Console hands the admin the invite link instead,
# and self-serve signup refuses (503) rather than create unverified accounts.
# SPENDVETO_MAIL_PROVIDER=brevo           # brevo | resend | postmark | console (prints to stderr; local only)
# SPENDVETO_MAIL_FROM=SpendVeto <noreply@spendveto.com>
# Where replies go — a noreply sender can't receive them.
# SPENDVETO_MAIL_REPLY_TO=
# BREVO_API_KEY=
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=

# --- Core storage ------------------------------------------------------------
# Unset: state lives in data/*.json (zero setup). Set: the core server keeps it
# in Postgres (server/store.js) and imports the data files on first start. Its
# own variable, so the Governance API's database never moves the core by accident.
# SPENDVETO_CORE_DATABASE_URL=postgres://spendveto:password@localhost:5432/spendveto
# Test database for `npm run test:pg-storage` (name must contain "test").
# SPENDVETO_TEST_DATABASE_URL=

# --- Governance API (npm run govern, :8405) — see govern/README.md ----------
# Required for the Governance API only; nothing else in the repo reads these.
# SPENDVETO_DATABASE_URL=postgres://spendveto:password@localhost:5432/spendveto
# cloud (default) refuses webhook targets on private/loopback/link-local
# addresses; self_hosted allows them (e.g. a receiver on the same network).
# SPENDVETO_DEPLOYMENT=cloud
# Enables POST /v1/operator/tenants. Unset = the operator API does not exist.
# SPENDVETO_OPERATOR_KEY=
# GOVERN_PORT=8405
# GOVERN_DB_POOL_MAX=10
# GOVERN_RATE_LIMIT_PER_SEC=200
# GOVERN_AUTO_MIGRATE=1
# X-Forwarded-For is believed only from a proxy on this machine; name another hop here.
# GOVERN_TRUST_PROXY=loopback
#
# Self-serve signup (POST /v1/signup — the form on spendveto.com/signup) uses
# the email settings in the "Email" section above; without them it refuses
# with 503 signup_unavailable. After the link creates the account a welcome
# email follows; its examples point at GOVERN_PUBLIC_URL.
# GOVERN_PUBLIC_URL=https://govern.spendveto.com
# GOVERN_DOCS_URL=https://spendveto.com/docs
# Where the email's link lands (the site's verify page).
# GOVERN_SIGNUP_VERIFY_URL=https://spendveto.com/signup/verify
# Extra browser origins allowed to call the signup routes (comma-separated).
# GOVERN_SIGNUP_ORIGINS=
# Cloudflare Turnstile secret: when set, signup requires a passing human check.
# GOVERN_TURNSTILE_SECRET=

# World ID proof-of-personhood gate on approvals (control #33) — needed only
# when data/policy.json sets requireWorldIdForApproval: true. Get an App ID
# from developer.worldcoin.org. Without it set, the gate refuses every
# approval honestly (world_id_not_configured) rather than faking a pass.
WORLD_APP_ID=
WORLD_ACTION=spendveto-approval
